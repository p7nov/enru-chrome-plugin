{
  "manifest_version": 3,
  "name": "EN/RU Split View",
  "version": "1.1",
  "description": "Opens the current documentation page side by side with its English/Russian counterpart.",
  "minimum_chrome_version": "155",
  "permissions": ["activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Split with the other language",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
